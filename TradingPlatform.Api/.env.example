# ASP.NET Core maps double underscores to nested configuration keys.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=tradingplatform;Username=your-postgres-user
Jwt__Key=replace-with-at-least-32-random-bytes
Jwt__Issuer=TradingPlatform.Api
Jwt__Audience=TradingPlatform.Client

App__FrontendUrl=http://localhost:4200

SeedAdmin__Name=Seed Admin
SeedAdmin__Email=admin@example.com
SeedAdmin__Password=replace-with-a-strong-unique-password

TwelveData__ApiKey=replace-with-your-twelve-data-api-key
TwelveData__BaseUrl=https://api.twelvedata.com

Email__Host=smtp.example.com
Email__Port=587
Email__User=replace-with-your-smtp-user
Email__Password=replace-with-your-smtp-password
Email__From=no-reply@example.com
Email__FromName=Stockfarm
